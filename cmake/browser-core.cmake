# First real application integration: background Blender + bpy, without GPU.
# This is an explicit development profile, not a full editor/renderer release.
set(WITH_BLENDER ON CACHE BOOL "")
set(WITH_PYTHON ON CACHE BOOL "")
set(WITH_PYTHON_MODULE OFF CACHE BOOL "")
set(WITH_PYTHON_INSTALL OFF CACHE BOOL "")
set(WITH_PYTHON_NUMPY OFF CACHE BOOL "")
set(PYTHON_VERSION "3.13" CACHE STRING "")
set(PYTHON_INCLUDE_DIR "${BROWSER_RUNTIME_PREFIX}/include/python3.13" CACHE PATH "")
set(PYTHON_INCLUDE_DIRS "${BROWSER_RUNTIME_PREFIX}/include/python3.13" CACHE PATH "")
set(PYTHON_LIBRARY "${BROWSER_RUNTIME_PREFIX}/lib/libpython3.13.a" CACHE FILEPATH "")
set(PYTHON_LIBPATH "${BROWSER_RUNTIME_PREFIX}/lib" CACHE PATH "")
set(PYTHON_EXECUTABLE "${BROWSER_HOST_PYTHON}" CACHE FILEPATH "")
set(WITH_LIBS_PRECOMPILED OFF CACHE BOOL "")
set(WITH_STRICT_BUILD_OPTIONS OFF CACHE BOOL "")
set(WITH_HEADLESS ON CACHE BOOL "")
set(WITH_GHOST_WEB OFF CACHE BOOL "")
set(WITH_GHOST_SDL OFF CACHE BOOL "")
set(WITH_GHOST_X11 OFF CACHE BOOL "")
set(WITH_GHOST_WAYLAND OFF CACHE BOOL "")
set(WITH_OPENGL_BACKEND OFF CACHE BOOL "")
set(WITH_VULKAN_BACKEND OFF CACHE BOOL "")
set(WITH_BUILDINFO OFF CACHE BOOL "")
set(WITH_COMPILER_SIMD OFF CACHE BOOL "")
set(SUPPORTS_NEON_BUILD FALSE CACHE INTERNAL "")
set(WITH_TBB OFF CACHE BOOL "")
set(WITH_TBB_MALLOC_PROXY OFF CACHE BOOL "")
set(WITH_ASSERT_ABORT ON CACHE BOOL "")
set(CMAKE_C_FLAGS_RELEASE "-O1" CACHE STRING "")
set(CMAKE_CXX_FLAGS_RELEASE "-O1" CACHE STRING "")
foreach(feature CYCLES OPENVDB NANOVDB OPENSUBDIV OPENIMAGEDENOISE LIBMV DRACO
    MESHOPTIMIZER MOD_FLUID AUDASPACE CODEC_FFMPEG CODEC_SNDFILE SDL JACK
    PULSEAUDIO OPENAL FFTW3 IMAGE_OPENJPEG IMAGE_WEBP GMP POTRACE HARU MANIFOLD
    QUADRIFLOW INPUT_NDOF BULLET XR_OPENXR ALEMBIC USD HYDRA MATERIALX
    INTERNATIONAL HARFBUZZ FRIBIDI RUBBERBAND LLVM CLANG TESTS GTESTS)
  set(WITH_${feature} OFF CACHE BOOL "")
endforeach()
