# Runtime flags apply to actual CLI tests, not CMake's pure-WASM type probes.
if(EMSCRIPTEN AND CMAKE_CURRENT_SOURCE_DIR STREQUAL CMAKE_SOURCE_DIR)
  # Emscripten's compatibility processor label is x86; these are wasm objects.
  set(CMAKE_SYSTEM_PROCESSOR wasm32)
  include("${CMAKE_CURRENT_LIST_DIR}/zlib-emscripten.cmake")
  function(blender_port_threaded_test_targets directory)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS targets)
      get_target_property(kind "${target}" TYPE)
      if(kind STREQUAL "EXECUTABLE")
        if(BROWSER_RUNTIME_PREFIX AND target STREQUAL "blender")
          set_property(TARGET "${target}" APPEND PROPERTY LINK_DEPENDS
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../native/browser/core_node_env.js")
        endif()
        target_link_options("${target}" PRIVATE -sEXIT_RUNTIME=1)
        if(WITH_WEBGPU_BACKEND AND target STREQUAL "blender")
          set_property(TARGET "${target}" APPEND PROPERTY LINK_DEPENDS
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/asyncify-cpu-initializers.json"
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/python-asyncify-imports.json")
          # Image libraries retain workers of their own. Prewarm a bounded
          # pool so a main-thread join never waits for a newly created browser
          # Worker whose startup requires returning to the event loop.
          target_link_options("${target}" PRIVATE -sPTHREAD_POOL_SIZE=8
            -sPTHREAD_POOL_SIZE_STRICT=2)
        else()
          target_link_options("${target}" PRIVATE -sPTHREAD_POOL_SIZE=2
            -sPTHREAD_POOL_SIZE_STRICT=0)
        endif()
        if(NOT (WITH_WEBGPU_BACKEND AND target STREQUAL "blender"))
          target_link_options("${target}" PRIVATE -sPROXY_TO_PTHREAD=1)
        endif()
        if(NOT BROWSER_RUNTIME_PREFIX)
          target_link_options("${target}" PRIVATE -sINITIAL_MEMORY=67108864)
        endif()
        if(BLENDER_PORT_FMT_CLASSIC_LOCALE)
          target_link_options("${target}" PRIVATE
            --pre-js "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/fmt_classic_locale_env.js")
        endif()
      endif()
    endforeach()
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
      blender_port_threaded_test_targets("${child}")
    endforeach()
  endfunction()
  cmake_language(DEFER CALL blender_port_threaded_test_targets "${CMAKE_SOURCE_DIR}")
  if(BLENDER_PORT_OIIO_SOURCE_DIR OR BROWSER_RUNTIME_PREFIX)
    # TIFF exports the module-style target name; zstd exports its config-style
    # name. Bind both names to the same real, tested WASM static archive.
    find_package(zstd CONFIG REQUIRED)
    if(NOT TARGET ZSTD::ZSTD)
      add_library(ZSTD::ZSTD ALIAS zstd::libzstd_static)
    endif()
  endif()
  if(BLENDER_PORT_OIIO_SOURCE_DIR)
    function(blender_port_oiio_sources)
      if(NOT TARGET OpenImageIO_Util)
        message(FATAL_ERROR "Expected OpenImageIO utility target is missing")
      endif()
      get_target_property(original OpenImageIO_Util SOURCES)
      get_target_property(directory OpenImageIO_Util SOURCE_DIR)
      target_include_directories(OpenImageIO_Util PRIVATE "${directory}")
      set(replaced)
      foreach(source IN LISTS original)
        get_filename_component(name "${source}" NAME)
        if(name STREQUAL "strutil.cpp" OR name STREQUAL "sysutil.cpp" OR name STREQUAL "ustring.cpp")
          list(APPEND replaced "${BLENDER_PORT_OIIO_SOURCE_DIR}/src/libutil/${name}")
        elseif(IS_ABSOLUTE "${source}" OR source MATCHES "^\\$<")
          list(APPEND replaced "${source}")
        else()
          list(APPEND replaced "${directory}/${source}")
        endif()
      endforeach()
      set_property(TARGET OpenImageIO_Util PROPERTY SOURCES "${replaced}")
    endfunction()
    cmake_language(DEFER CALL blender_port_oiio_sources)
  endif()
endif()
