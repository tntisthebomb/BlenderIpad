#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,r32ui) uniform uimage2DArray atlas;
void main() {
  uint i=gl_GlobalInvocationID.x;
  // All 1024 invocations contend for these two texels.
  imageAtomicMin(atlas,ivec3(0,0,0),1024u-i);
  imageAtomicAdd(atlas,ivec3(1,0,0),1u);
  // Invalid virtual shadow pages must not modify any valid texel.
  imageAtomicMin(atlas,ivec3(0,0,-1),0u);
  imageAtomicAdd(atlas,ivec3(0,0,1),1u);
}
