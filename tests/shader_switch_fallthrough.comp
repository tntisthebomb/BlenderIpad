#version 450
layout(local_size_x=1) in;
layout(set=0, binding=0, std430) buffer Results { int values[]; } output_data;
int calculate(int selector) {
  int value = 1;
  switch (selector) {
    case 0: value += 2;
    case 1: value *= 3; break;
    case 2:
      if (selector >= 1 && selector < 4) value += 5;
    case 3:
      for (int i = 0; i < 7; i++) value++;
      break;
    default: value = -5;
  }
  return value;
}
void main() {
  uint index = gl_GlobalInvocationID.x;
  if (index < 6) output_data.values[index] = calculate(int(index));
}
