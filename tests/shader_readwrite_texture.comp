#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) buffer Results { uint values[]; } output_data;
layout(set=0,binding=1,r32ui) uniform uimage2D target;
void main() {
  uint value=imageLoad(target,ivec2(0)).x+4u;
  imageStore(target,ivec2(0),uvec4(value));
  output_data.values[0]=imageLoad(target,ivec2(0)).x;
}
