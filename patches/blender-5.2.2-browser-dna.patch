  * Parse header files to generate SDNA blob and auxiliary files.
  * \{ */
 
+#ifdef __EMSCRIPTEN__
+static Vector<dna::ParsedStruct> native_schema_with_padding(
+    const TypeTable &table, const Span<dna::ParsedStruct> original)
+{
+  Vector<dna::ParsedStruct> result(original);
+  for (dna::ParsedStruct &structure : result) {
+    Vector<dna::ParsedMember> members;
+    int offset = 0;
+    int padding_id = 0;
+    const auto append_padding = [&](const int bytes) {
+      if (bytes == 0) return;
+      std::string name = "_pad_wasm_native_" + std::to_string(padding_id++) +
+                         "[" + std::to_string(bytes) + "]";
+      for (const dna::ParsedMember &existing : structure.members) {
+        BLI_assert(existing.member_name != name);
+      }
+      members.append(dna::ParsedMember{.type_name = "char", .member_name = name,
+                                      .alias_member_name = name, .alignment = 0});
+    };
+    for (const dna::ParsedMember &member : structure.members) {
+      const TypeInfo &type = table.lookup(member.type_name);
+      const int aligned = native_align_up(offset, native_member_alignment(type, member));
+      append_padding(aligned - offset);
+      members.append(member);
+      offset = aligned + member_size_native(type, member);
+    }
+    const int total = table.lookup(structure.type_name).size_native;
+    BLI_assert(offset <= total);
+    append_padding(total - offset);
+    structure.members = std::move(members);
+  }
+  return result;
+}
+#endif
