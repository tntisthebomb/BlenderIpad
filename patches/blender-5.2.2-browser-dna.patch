+#ifdef __EMSCRIPTEN__
+static int native_member_alignment(const TypeInfo &type, const dna::ParsedMember &member)
+{
+  const char *name = member.member_name.c_str();
+  const int alignment = (name[0] == '*' || name[1] == '*') ? int(alignof(void *)) :
+                                                               int(type.align_native);
+  return std::max(1, std::max(alignment, member.alignment));
+}
+
+static int native_align_up(int offset, int alignment)
+{
+  return ((offset + alignment - 1) / alignment) * alignment;
+}
+#endif
 
