+
+/* Yield between complete CPU registration stages, never inside their registries. */
+static void gpu_init_trace(const char *stage)
+{
+#if defined(__EMSCRIPTEN__) && defined(WITH_WEBGPU_BACKEND)
+  blender_browser_startup_checkpoint(nullptr);
+#endif
+#ifdef __EMSCRIPTEN__
+  const char *enabled = std::getenv("BLENDER_GPU_INIT_TRACE");
+  if (enabled && enabled[0] == '1') {
+    std::fprintf(stderr, "GPU initialization: %s\n", stage);
+  }
+#else
+  (void)stage;
+#endif
+}
