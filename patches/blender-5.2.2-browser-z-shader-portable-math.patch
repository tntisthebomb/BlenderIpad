+
+/* Integer ID buffers use nearest sampling, one mip and clamp-to-edge.
+ * WebGPU cannot filter integer textures: fetch the corresponding texel. */
+uint4 gpu_texel_fetch_nearest(usampler2D image, float2 uv)
+{
+#ifdef GPU_WEBGPU
+  int2 size = textureSize(image, 0);
+  int2 coordinate = clamp(int2(floor(uv * float2(size))), int2(0), size - int2(1));
+  return texelFetch(image, coordinate, 0);
+#else
+  return textureLod(image, uv, 0.0f);
+#endif
+}
