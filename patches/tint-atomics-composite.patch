+                auto* member_ptr = b.Access(member_ptr_ty, base_ptr, u32(i))->Result();
+
+                auto* src_member_ty = src_str->Members()[i]->Type();
+                auto* member_val = b.Access(src_member_ty, src_val, u32(i))->Result();
